{
  "name": "@dsh-video/web-video-workbench",
  "version": "0.1.0",
  "description": "Three-column HTML/Remotion Video Workbench & Top-Bar Capsule Switcher for DeepSeek Harness",
  "license": "MIT",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "dependencies": {
    "@dsh-video/shared": "workspace:*",
    "@dsh-video/tool-local-tts": "workspace:*",
    "@dsh-video/tool-avatar": "workspace:*",
    "@dsh-video/tool-video-suite": "workspace:*",
    "@dsh-video/tool-media": "workspace:*",
    "@dsh-video/preset-video": "workspace:*"
  }
}
